{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "coverage", "limitations"],
  "properties": {
    "verdict": { "type": "string", "enum": ["APPROVED", "REVISE", "BLOCKED"] },
    "summary": { "type": "string", "pattern": "\\S" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "path", "evidence", "fix"],
        "properties": {
          "id": { "type": "string", "pattern": "\\S" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "path": { "type": "string", "pattern": "\\S" },
          "evidence": { "type": "string", "pattern": "\\S" },
          "fix": { "type": "string", "pattern": "\\S" }
        }
      }
    },
    "coverage": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } },
    "limitations": { "type": "array", "items": { "type": "string", "pattern": "\\S" } }
  }
}
